PORT=8000
NODE_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql://postgres:password@localhost:5432/shokherboard
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# CORS — comma-separated browser origins allowed to call the API (REST + Socket.IO).
# Omit and CORS falls back to localhost only, blocking any deployed frontend.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Email (nodemailer) — the code reads MAIL_* (see src/utils/mailer.js).
# Leave MAIL_HOST empty in development to print emails (e.g. sign-up codes) to the server log.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your@email.com
MAIL_PASS=app-pass
MAIL_FROM_NAME=ShokherBoard
MAIL_FROM_ADDRESS=your@email.com

# Admin seed credentials (npm run seed:users)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# Slack integration — each user can connect their own workspace. See docs/slack.md
# Redirect URI must be HTTPS and match the one added in your Slack app:
#   https://<your-api-domain>/api/v1/integrations/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
# Optional: override bot scopes (comma-separated)
# SLACK_SCOPES=chat:write,chat:write.public,channels:read,groups:read,users:read,users:read.email,team:read
# SLACK_USER_SCOPES=users:read,users:read.email,chat:write

# Encryption key for stored secrets such as Slack tokens (64 hex chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
